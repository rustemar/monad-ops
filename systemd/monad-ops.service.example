[Unit]
Description=monad-ops — validator node operational observability
After=network-online.target monad-execution.service
Wants=network-online.target

[Service]
Type=simple
User=<node-user>
Group=<node-user>
# Uncomment if your run-user is NOT already in `systemd-journal` via
# its primary group. The bft + execution tailers shell out to
# journalctl and need read access; without this the rule engine
# silently runs blind on consensus events.
#SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/monad-ops
Environment=PYTHONUNBUFFERED=1
Environment=MONAD_OPS_CONFIG=/opt/monad-ops/config.toml
ExecStart=/opt/monad-ops/.venv/bin/python -m monad_ops.cli run
# Restart=always, not on-failure. A clean SIGTERM is a *successful*
# exit as far as systemd is concerned, so on-failure leaves the daemon
# down after anything that terminates it politely from outside — a
# stray pkill, a fat-fingered kill, a supervisor cleaning up. For a
# monitoring sidecar that is the worst time to be down, and nothing
# here ever exits cleanly on its own. An explicit `systemctl stop` is
# still honoured: systemd does not restart after an operator stop.
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening (keep minimal — we need to read the journal and the node config)
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
